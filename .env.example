# Copy this file to `.env.local` in the same folder as package.json, then set values.
# `.env.local` is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=

# Optional: override default model (see Anthropic models docs)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: music ID (analyze still works without these)
# ACRCLOUD_HOST=
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=

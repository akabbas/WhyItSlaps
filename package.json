{
  "name": "whyitslaps",
  "version": "0.1.0",
  "private": true,
  "description": "Video & music analyzer: short-form video critique (palette, vision API, ACRCloud, edit plan) + Spotify track analysis (audio features + structured breakdown). Next.js, yt-dlp, ffmpeg, Anthropic, Spotify.",
  "whyitslaps": {
    "anthropic_env_var": "ANTHROPIC_API_KEY",
    "paste_key_in_file_not_here": ".env.local (create/edit in repo root)"
  },
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "test": "node --experimental-strip-types --experimental-detect-module --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/still-exif.test.ts",
    "test:sonic-scores": "node --experimental-strip-types --test lib/sonic-scores.test.ts lib/preview-match.test.ts lib/cleanup.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "next": "^14.2.35",
    "node-vibrant": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.46",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  }
}

{
  "manifest_version": 3,
  "name": "WhyItSlaps",
  "version": "1.0.0",
  "description": "Capture Instagram reel video URLs and analyze them on WhyItSlaps.",
  "permissions": ["webRequest", "storage"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "https://whyitslaps.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://whyitslaps.com/*", "http://localhost:3000/*"],
      "js": ["injector.js"],
      "run_at": "document_start"
    }
  ]
}

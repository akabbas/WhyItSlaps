# local tools / IDE
.claude/
# Cursor: track agent skills/hooks; ignore local IDE state and Impeccable engine binary
.cursor/*
!.cursor/skills/
!.cursor/agents/
!.cursor/hooks.json
.cursor/skills/impeccable/scripts/bin/
*.tsbuildinfo

# Impeccable ephemeral (see https://github.com/pbakaus/impeccable — track config.json, design.json, critique/*.md)
.impeccable/*
!.impeccable/config.json
!.impeccable/design.json
!.impeccable/critique/
!.impeccable/surfaces/
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/review/
.impeccable/questions/
.impeccable/live/

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel
